FROM python:3.11-slim

LABEL maintainer="FTA/ETA Editor"
LABEL description="FTA/ETA Editor Web Application for Render.com"
LABEL version="1.4.2"

# Install system dependencies including Graphviz and Japanese fonts
# Combine commands to minimize layers and ensure cleanup
RUN set -ex && \
    apt-get update && \
    apt-get install -y --no-install-recommends graphviz fonts-noto-cjk && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY src/ ./src/
COPY web_app/ ./web_app/
COPY data/ ./data/

# Create session directory with proper permissions
RUN mkdir -p /tmp/fta_editor_sessions && chmod 777 /tmp/fta_editor_sessions

# Expose port (Render will set PORT env var)
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:5000/', timeout=5)" || exit 1

# Run gunicorn with proper error handling
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-5000} --workers 2 --timeout 120 --access-logfile - --error-logfile - web_app.app:app"]
